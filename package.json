{
  "name": "xuan-bd",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "web": "node --import tsx scripts/web.ts",
    "workspace": "node --import tsx scripts/bd-workspace.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build --configLoader runner",
    "local:check": "node scripts/local-web.mjs check",
    "local:prepare": "node scripts/local-web.mjs prepare",
    "local:web": "node scripts/local-web.mjs start",
    "test": "node scripts/test-local.mjs",
    "test:python": "node scripts/test-local.mjs --python-only",
    "repo:check": "node scripts/repository-check.mjs",
    "test:recipe": "node --test scripts/repository-check.test.mjs"
  },
  "dependencies": {
    "@assistant-ui/react": "0.15.23",
    "@earendil-works/pi-ai": "1.0.1",
    "@earendil-works/pi-coding-agent": "1.0.1",
    "@mozilla/readability": "0.6.0",
    "@napi-rs/canvas": "1.0.11",
    "@openclaw/fs-safe": "0.23.0",
    "diff": "8.0.4",
    "dotenv": "18.0.5",
    "express": "5.2.1",
    "iconv-lite": "0.7.3",
    "ipaddr.js": "1.9.1",
    "linkedom": "0.18.13",
    "morphicons": "2.0.0",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "saxes": "6.0.0",
    "typebox": "1.3.27",
    "undici": "8.10.2",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "esbuild": "0.28.2",
    "lucide-react": "0.577.0",
    "radix-ui": "1.6.7",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  },
  "packageManager": "npm@11.19.1"
}
