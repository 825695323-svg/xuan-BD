{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wfd.example/spec/v1.3/wfd-snapshot.schema.json",
  "title": "wfd-snapshot V1.1 联合修订草案",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format_version": {
      "const": "wfd.snapshot/1.3-candidate"
    },
    "dataset_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
    },
    "snapshot_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
    },
    "parent_snapshot_id": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "publish_plan_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
    },
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
          },
          "manifest_ref": {
            "$ref": "https://wfd.example/spec/v1.3/wfd-common.schema.json#/$defs/ImmutableRef"
          }
        },
        "required": [
          "product_id",
          "manifest_ref"
        ],
        "additionalProperties": false
      }
    },
    "registry_refs": {
      "type": "array",
      "items": {
        "$ref": "https://wfd.example/spec/v1.3/wfd-common.schema.json#/$defs/ImmutableRef"
      }
    },
    "evidence_binding_refs": {
      "type": "array",
      "items": {
        "$ref": "https://wfd.example/spec/v1.3/wfd-common.schema.json#/$defs/EvidenceRef"
      }
    },
    "governance_refs": {
      "type": "array",
      "items": {
        "$ref": "https://wfd.example/spec/v1.3/wfd-common.schema.json#/$defs/ImmutableRef"
      }
    }
  },
  "required": [
    "format_version",
    "dataset_id",
    "snapshot_id",
    "parent_snapshot_id",
    "publish_plan_id",
    "request_id",
    "products",
    "registry_refs",
    "evidence_binding_refs",
    "governance_refs"
  ],
  "$comment": "V1.3 compatible schema; semantics pending SDK and real data verification."
}
