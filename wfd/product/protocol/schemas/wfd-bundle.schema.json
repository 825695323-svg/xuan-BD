{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wfd.example/spec/v1.3/wfd-bundle.schema.json",
  "title": "wfd-bundle V1.1 联合修订草案",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format_version": {
      "const": "wfd.bundle/1.3-candidate"
    },
    "bundle_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
    },
    "mode": {
      "type": "string",
      "enum": [
        "full",
        "delta",
        "reference"
      ]
    },
    "source_dataset_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
    },
    "source_snapshot_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
    },
    "selection": {
      "type": "object",
      "additionalProperties": true
    },
    "selection_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
          },
          "export_manifest_ref": {
            "$ref": "https://wfd.example/spec/v1.3/wfd-common.schema.json#/$defs/ImmutableRef"
          }
        },
        "required": [
          "product_id",
          "export_manifest_ref"
        ],
        "additionalProperties": false
      }
    },
    "read_dependencies": {
      "type": "array",
      "items": {
        "$ref": "https://wfd.example/spec/v1.3/wfd-common.schema.json#/$defs/ImmutableRef"
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "$ref": "https://wfd.example/spec/v1.3/wfd-common.schema.json#/$defs/EvidenceRef"
      }
    },
    "object_inventory": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "relative_path": {
            "type": "string"
          },
          "file_sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "byte_size": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "relative_path",
          "file_sha256",
          "byte_size"
        ],
        "additionalProperties": false
      }
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "read_self_contained": {
          "type": "boolean"
        },
        "evidence_self_contained": {
          "type": "boolean"
        },
        "recomputable": {
          "type": "boolean"
        },
        "offline_available": {
          "type": "boolean"
        },
        "offline_plaintext": {
          "type": "boolean"
        }
      },
      "required": [
        "read_self_contained",
        "evidence_self_contained",
        "recomputable",
        "offline_available",
        "offline_plaintext"
      ],
      "additionalProperties": false
    },
    "source_state": {
      "oneOf": [
        {
          "$ref": "https://wfd.example/spec/v1.3/wfd-common.schema.json#/$defs/BundleStateDigest"
        },
        {
          "type": "null"
        }
      ]
    },
    "base_state": {
      "oneOf": [
        {
          "$ref": "https://wfd.example/spec/v1.3/wfd-common.schema.json#/$defs/BundleStateDigest"
        },
        {
          "type": "null"
        }
      ]
    },
    "target_state": {
      "oneOf": [
        {
          "$ref": "https://wfd.example/spec/v1.3/wfd-common.schema.json#/$defs/BundleStateDigest"
        },
        {
          "type": "null"
        }
      ]
    },
    "import_identity_map": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_ref": {
            "$ref": "https://wfd.example/spec/v1.3/wfd-common.schema.json#/$defs/IdentityRef"
          },
          "target_ref": {
            "$ref": "https://wfd.example/spec/v1.3/wfd-common.schema.json#/$defs/IdentityRef"
          },
          "evidence_ref": {
            "$ref": "https://wfd.example/spec/v1.3/wfd-common.schema.json#/$defs/EvidenceRef"
          }
        },
        "required": [
          "source_ref",
          "target_ref",
          "evidence_ref"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "format_version",
    "bundle_id",
    "mode",
    "source_dataset_id",
    "source_snapshot_id",
    "selection",
    "selection_digest",
    "products",
    "read_dependencies",
    "evidence_refs",
    "object_inventory",
    "capabilities",
    "source_state",
    "base_state",
    "target_state",
    "import_identity_map"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "delta"
          }
        }
      },
      "then": {
        "properties": {
          "base_state": {
            "$ref": "https://wfd.example/spec/v1.3/wfd-common.schema.json#/$defs/BundleStateDigest"
          },
          "target_state": {
            "$ref": "https://wfd.example/spec/v1.3/wfd-common.schema.json#/$defs/BundleStateDigest"
          }
        }
      }
    }
  ],
  "$comment": "V1.3 compatible schema; semantics pending SDK and real data verification."
}
