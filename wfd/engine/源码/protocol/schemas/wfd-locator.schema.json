{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wfd.example/spec/v1.3/wfd-locator.schema.json",
  "title": "wfd-locator V1.1 联合修订草案",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format_version": {
      "const": "wfd.locator/1.3-candidate"
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "locator_generation": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
    },
    "storage_mode": {
      "type": "string",
      "enum": [
        "standalone_file",
        "tar_slice",
        "zip_member"
      ]
    },
    "container_rel_path": {
      "type": "string"
    },
    "container_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "member_name": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "byte_offset": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "byte_length": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "compression_codec": {
      "type": "string"
    },
    "storage_health": {
      "type": "string",
      "enum": [
        "healthy",
        "degraded",
        "unknown"
      ]
    }
  },
  "required": [
    "format_version",
    "content_sha256",
    "locator_generation",
    "storage_mode",
    "container_rel_path",
    "container_sha256",
    "member_name",
    "byte_offset",
    "byte_length",
    "compression_codec",
    "storage_health"
  ],
  "$comment": "V1.3 compatible schema; semantics pending SDK and real data verification."
}
