{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wfd.example/spec/v1.3/wfd-read.schema.json",
  "title": "wfd-read V1.1 联合修订草案",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "protocol_version": {
      "const": "wfd.read/1.3-candidate"
    },
    "dataset_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
    },
    "operation": {
      "type": "string",
      "enum": [
        "read_product",
        "read_company_context",
        "read_relation_graph",
        "read_applicable_rules",
        "read_event_timeline",
        "trace_evidence"
      ]
    },
    "snapshot_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
    },
    "history_mode": {
      "type": "string",
      "enum": [
        "snapshot_contents",
        "market_known_at",
        "system_held_at"
      ]
    },
    "knowledge_cutoff": {
      "oneOf": [
        {
          "$ref": "https://wfd.example/spec/v1.3/wfd-common.schema.json#/$defs/TimeWithPrecision"
        },
        {
          "type": "null"
        }
      ]
    },
    "held_scope": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "usable_stage": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "acquired",
            "custodied",
            "published_readable"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "subject": {
      "oneOf": [
        {
          "$ref": "https://wfd.example/spec/v1.3/wfd-common.schema.json#/$defs/IdentityRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "max_depth": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "max_nodes": {
      "type": "integer",
      "minimum": 1
    },
    "max_edges": {
      "type": "integer",
      "minimum": 1
    },
    "max_scan_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "max_execution_time_ms": {
      "type": "integer",
      "minimum": 1
    },
    "result_mode": {
      "type": "string",
      "enum": [
        "edges",
        "paths"
      ]
    },
    "cursor": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "protocol_version",
    "dataset_id",
    "operation",
    "snapshot_id",
    "history_mode",
    "knowledge_cutoff",
    "held_scope",
    "usable_stage",
    "subject",
    "max_depth",
    "max_nodes"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "history_mode": {
            "enum": [
              "market_known_at",
              "system_held_at"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "knowledge_cutoff": {
            "$ref": "https://wfd.example/spec/v1.3/wfd-common.schema.json#/$defs/TimeWithPrecision"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "history_mode": {
            "const": "system_held_at"
          }
        }
      },
      "then": {
        "properties": {
          "held_scope": {
            "type": "string"
          },
          "usable_stage": {
            "enum": [
              "acquired",
              "custodied",
              "published_readable"
            ]
          }
        }
      }
    }
  ],
  "$comment": "V1.3 compatible schema; semantics pending SDK and real data verification."
}
